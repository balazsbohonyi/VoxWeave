{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxWeave",
  "version": "1.0.0",
  "identifier": "com.balazs.bohonyi.voxweave",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "VoxWeave Settings",
        "url": "index.html",
        "width": 560,
        "height": 450,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "decorations": true,
        "resizable": false
      },
      {
        "label": "indicator",
        "title": "VoxWeave Indicator",
        "url": "indicator.html",
        "width": 180,
        "height": 38,
        "minWidth": 180,
        "minHeight": 38,
        "maxWidth": 180,
        "maxHeight": 38,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "toast",
        "title": "VoxWeave Toast",
        "url": "toast.html",
        "width": 180,
        "height": 108,
        "minWidth": 180,
        "minHeight": 108,
        "maxWidth": 180,
        "maxHeight": 108,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "wizard",
        "title": "VoxWeave Wizard",
        "url": "wizard.html",
        "width": 560,
        "height": 550,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "decorations": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
